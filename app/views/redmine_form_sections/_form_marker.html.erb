<% if @issue.project&.module_enabled?('redmine_form_sections') %>
<% sections = RedmineFormSections::LayoutProvider.for_issue(@issue) %>

<div id="rfs-sections"
     data-project-id="<%= @issue.project_id %>"
     data-tracker-id="<%= @issue.tracker_id %>"
     data-sections="<%= sections.to_json %>"></div>

<style>
  #rfs-sections:empty {
    display: none;
  }

  #rfs-sections .rfs-section {
    border: 1px solid #c5d0d8;
    border-radius: 6px;
    padding: 12px 16px;
    margin: 12px 0;
  }

  #rfs-sections .rfs-section legend {
    font-weight: bold;
    padding: 0 8px;
  }
</style>

<script>
(() => {
  const attributes = document.getElementById('attributes');
  const container = document.getElementById('rfs-sections');

  if (!attributes || !container) return;

  const sections = JSON.parse(container.dataset.sections || 'null');

  // Aucun paramétrage pour ce tracker : formulaire natif
  if (!Array.isArray(sections) || sections.length === 0) {
    container.remove();
    return;
  }

  // Mémoriser les champs personnalisés natifs et leur ordre
  // Les champs pleine largeur sont directement sous #attributes.
  const originalFields = [
    ...attributes.querySelectorAll(
      '.splitcontentleft > p, .splitcontentright > p, :scope > p'
    )
  ].filter(p =>
    p.querySelector('[name^="issue[custom_field_values]"]')
  );

  // Identifier les champs initialement affichés en pleine largeur.
  const fullWidthFields = new Set(
    originalFields.filter(p => p.parentElement === attributes)
  );

  // Retrouver un champ à partir de son identifiant Redmine
  function findField(id) {
    return originalFields.find(p =>
      p.querySelector(
        `[name^="issue[custom_field_values][${id}]"]`
      )
    ) ?? null;
  }

  // Créer une section à partir de champs HTML existants
  function addSection(title, leftFields, rightFields, twoColumns) {

    // Séparer les champs classiques des champs pleine largeur.
    const normalLeft = leftFields.filter(
      field => !fullWidthFields.has(field)
    );

    const normalRight = rightFields.filter(
      field => !fullWidthFields.has(field)
    );

    const fullWidth = [...leftFields, ...rightFields].filter(
      field => fullWidthFields.has(field)
    );

    // Ne jamais créer de section vide.
    if (!normalLeft.length && !normalRight.length && !fullWidth.length) {
      return;
    }

    const fieldset = document.createElement('fieldset');
    fieldset.className = 'rfs-section';

    const legend = document.createElement('legend');
    legend.textContent = title;

    fieldset.appendChild(legend);

    // Créer les colonnes uniquement si elles contiennent
    // au moins un champ classique.
    if (normalLeft.length || normalRight.length) {

      const splitcontent = document.createElement('div');
      splitcontent.className = 'splitcontent';

      const columns = [
        ['splitcontentleft', normalLeft]
      ];

      if (twoColumns) {
        columns.push(['splitcontentright', normalRight]);
      }

      for (const [className, fields] of columns) {
        const column = document.createElement('div');
        column.className = className;

        for (const field of fields) {
          column.appendChild(field);
        }

        splitcontent.appendChild(column);
      }

      fieldset.appendChild(splitcontent);
    }

    // Les champs pleine largeur sont placés sous les colonnes.
    for (const field of fullWidth) {
      fieldset.appendChild(field);
    }

    container.appendChild(fieldset);
  }

  // Conserver le conteneur dans la zone native des attributs
  attributes.appendChild(container);
  
  // 1. Construire les sections configurées
  for (const section of sections) {

    // Deux colonnes si right est explicitement déclaré.
    const twoColumns = Object.prototype.hasOwnProperty.call(
      section,
      'right'
    );

    const leftFields = section.left.map(findField).filter(Boolean);

    const rightFields = twoColumns
      ? section.right.map(findField).filter(Boolean)
      : [];

    addSection(
      section.title,
      leftFields,
      rightFields,
      twoColumns
    );
  }

  // 2. Identifier les champs non affectés
  const remainingFields = originalFields.filter(field =>
    !container.contains(field)
  );

  // 3. Les répartir dans la section "Autres champs"
  if (remainingFields.length) {

    // Champs classiques à répartir sur deux colonnes.
    const normalFields = remainingFields.filter(
      field => !fullWidthFields.has(field)
    );

    // Champs devant rester sur toute la largeur.
    const fullWidth = remainingFields.filter(
      field => fullWidthFields.has(field)
    );

    const leftCount = Math.ceil(normalFields.length / 2);

    addSection(
      "<%= j(l(:label_rfs_other_fields)) %>",
      [
        ...normalFields.slice(0, leftCount),
        ...fullWidth
      ],
      normalFields.slice(leftCount),
      true
    );
  }

  // Supprimer le conteneur si aucune section n'a été créée
  if (!container.children.length) {
    container.remove();
  }
})();
</script>
<% end %>