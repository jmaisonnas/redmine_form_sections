<% if @issue.project&.module_enabled?('redmine_form_sections') %>
<div id="rfs-sections" data-project-id="<%= @issue.project_id %>" data-tracker-id="<%= @issue.tracker_id %>"></div>

<style>
  #rfs-sections:empty {
    display: none;
  }

  #rfs-sections .rfs-section {
    border: 1px solid #c5d0d8;
    border-radius: 6px;
    padding: 12px 16px;
    margin: 12px 0;
  }

  #rfs-sections .rfs-section legend {
    font-weight: bold;
    padding: 0 8px;
  }
</style>

<script>
(() => {

  // ==========================================================
  // CONFIGURATION DES FORMULAIRES
  // ==========================================================

  const configurations = {
    1: [
      {
        title: 'Application',
        left: [1],
        right: [2]
      },
      {
        title: 'Client',
        left: [3],
        right: [4]
      }
    ]
  };

  // ==========================================================
  // INITIALISATION
  // ==========================================================

  const attributes = document.getElementById('attributes');
  const container = document.getElementById('rfs-sections');

  if (!attributes || !container) {
    return;
  }

  const trackerId = container.dataset.trackerId;

  // Configuration centrale du tracker.
  const sections = configurations[trackerId];

  // Aucune configuration : on conserve le formulaire natif.
  if (!sections) {
    container.remove();
    return;
  }

  attributes.appendChild(container);  

  // ==========================================================
  // RECHERCHE DES CHAMPS
  // ==========================================================

  function findField(id) {
    const control = attributes.querySelector(
      `#issue_custom_field_values_${id}`
    );

    return control?.closest('p') ?? null;
  }

  // ==========================================================
  // CONSTRUCTION DES SECTIONS
  // ==========================================================

  for (const section of sections) {

    const leftColumn = document.createElement('div');
    leftColumn.className = 'splitcontentleft';

    const rightColumn = document.createElement('div');
    rightColumn.className = 'splitcontentright';

    // Placement des champs de gauche.
    for (const id of section.left) {
      const field = findField(id);

      if (field) {
        leftColumn.appendChild(field);
      }
    }

    // Placement des champs de droite.
    for (const id of section.right) {
      const field = findField(id);

      if (field) {
        rightColumn.appendChild(field);
      }
    }

    // Aucun champ trouvé : on ignore cette section.
    if (!leftColumn.children.length && !rightColumn.children.length) {
      continue;
    }

    // Création du conteneur de section.
    const fieldset = document.createElement('fieldset');
    fieldset.className = 'rfs-section';

    const legend = document.createElement('legend');
    legend.textContent = section.title;

    // Structure native de Redmine pour les deux colonnes.
    const splitcontent = document.createElement('div');
    splitcontent.className = 'splitcontent';

    if (leftColumn.children.length) {
      splitcontent.appendChild(leftColumn);
    }

    if (rightColumn.children.length) {
      splitcontent.appendChild(rightColumn);
    }

    fieldset.appendChild(legend);
    fieldset.appendChild(splitcontent);

    container.appendChild(fieldset);
  }

  // Aucune section créée : nettoyage.
  if (!container.children.length) {
    container.remove();
  }

})();
</script>
<% end %>